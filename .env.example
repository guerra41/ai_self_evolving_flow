# Proposer LLM (optional). With none of these set, `pnpm evolve` uses the scripted offline demo.
#
# Option A: local model with Ollama (free, nothing leaves your machine, no key needed).
#   1. Install Ollama, then run: ollama pull qwen2.5-coder:7b
#   2. Uncomment the two lines below.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5-coder:7b
#
# Option B: hosted OpenAI-compatible API (paid).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# How long to wait for one reply from the model, in milliseconds (default 600000 = 10 min).
# LLM_TIMEOUT_MS=600000

# Evolution guardrails
EVOLUTION_GENERATIONS=5
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_MB=256
